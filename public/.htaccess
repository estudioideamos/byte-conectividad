<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.byteconectividad\.com\.ar$ [NC]
  RewriteRule ^ https://byteconectividad.com.ar%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?:png|jpe?g|webp|svg|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(?:html|rsc)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
